# Copy to .env.local and fill in. Never commit real values.
# For Cloudflare, set NEXT_PUBLIC_* at build time and the rest as Worker secrets
# (npx wrangler secret put NAME). For `npm run preview`, put them in .dev.vars.

# Site
NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare R2 public media base URL (no trailing slash)
NEXT_PUBLIC_MEDIA_URL=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CHURCH_OFFICE_EMAIL=

# Contact form spam protection (register your production and localhost hostnames)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Error monitoring (Sentry)
NEXT_PUBLIC_SENTRY_DSN=
